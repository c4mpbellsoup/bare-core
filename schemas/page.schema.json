{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/c4mpbellsoup/bare-schema/refs/heads/master/schemas/page.schema.json",
	"title": "Page",
	"type": "object",

	"properties": {
		"route": {
			"description": "The route of the page.",
			"type": "string",
			"pattern": "^/(?:[A-Za-z0-9-]+/?)*$"
		},
		"title": { "$ref": "./shared/label.schema.json" },
		"sections": {
			"type": "array",
			"items": {
				"oneOf": [{ "$ref": "./components/sections/hero.schema.json" }]
			}
		}
	},

	"required": ["route", "title", "sections"],
	"additionalProperties": false
}
