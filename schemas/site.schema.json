{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/c4mpbellsoup/bare-schema/refs/heads/master/schemas/site.schema.json",
	"title": "Bare Site",
	"description": "The schema for a Bare Site.",
	"type": "object",

	"properties": {
		"schemaVersion": {
			"description": "The version of the Bare Site schema used by this site.",
			"type": "integer",
			"const": 1
		},
		"name": { "$ref": "./shared/label.schema.json" },
		"description": {
			"description": "A short description of the site.",
			"type": "string",
			"minLength": 1,
			"maxLength": 150
		},
		"template": { "$ref": "./template.schema.json" },
		"theme": { "$ref": "./theme.schema.json" }
	},

	"required": ["schemaVersion", "name", "template", "theme"],
	"additionalProperties": false
}
