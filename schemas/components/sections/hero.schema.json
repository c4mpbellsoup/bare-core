{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/c4mpbellsoup/bare-schema/refs/heads/master/schemas/components/sections/hero.schema.json",
	"title": "Hero",
	"type": "object",

	"properties": {
		"type": { "const": "hero" },
		"image": { "type": "string" },
		"heading": { "type": "string" },
		"subheading": { "type": "string" },
		"actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
	},

	"required": ["type", "image", "heading"],
	"additionalProperties": false,

	"$defs": {
		"action": {
			"type": "object",
			"required": ["label", "href"],
			"properties": {
				"label": { "$ref": "../../shared/label.schema.json" },
				"href": { "$ref": "../../shared/href.schema.json" }
			}
		}
	}
}
