{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/c4mpbellsoup/bare-schema/refs/heads/master/schemas/components/header.schema.json",
	"title": "Header",
	"type": "object",

	"properties": {
		"menu": { "$ref": "../shared/menu.schema.json" },
		"left": { "$ref": "#/$defs/headerSection" },
		"centre": { "$ref": "#/$defs/headerSection" },
		"right": { "$ref": "#/$defs/headerSection" },
		"contentWidth": { "$ref": "../shared/content-width.schema.json" },
		"visible": {
			"description": "Whether to display the header.",
			"type": "boolean",
			"default": true
		}
	},

	"required": ["menu"],

	"anyOf": [
		{ "required": ["left"] },
		{ "required": ["centre"] },
		{ "required": ["right"] }
	],

	"additionalProperties": false,

	"$defs": {
		"headerSection": {
			"type": "object",
			"required": ["type"],
			"unevaluatedProperties": false,
			"oneOf": [
				{ "properties": { "type": { "const": "logo" } } },
				{
					"required": ["menu"],
					"properties": {
						"type": { "const": "menu" },
						"menu": {
							"type": "array",
							"items": { "$ref": "../shared/id.schema.json" }
						}
					}
				}
			]
		}
	}
}
