{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/c4mpbellsoup/bare-schema/refs/heads/master/site.schema.json",
	"title": "Bare Site",
	"description": "The schema for a Bare website.",
	"type": "object",

	"required": ["schemaVersion", "name", "header", "footer", "pages"],

	"properties": {
		"schemaVersion": {
			"description": "The version of the Bare Site schema used by this site.",
			"type": "integer",
			"const": 1
		},
		"name": {
			"description": "The name of the site (business, organisation, etcetera).",
			"type": "string",
			"minLength": 1,
			"maxLength": 50
		},
		"description": {
			"description": "A short description of the site.",
			"type": "string",
			"maxLength": 150
		},
		"header": {
			"$ref": "#/$defs/header"
		},
		"footer": {
			"$ref": "#/$defs/footer"
		},
		"pages": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "./page.schema.json"
			}
		}
	},

	"$defs": {
		"header": {
			"type": "object",
			"properties": {
				"visible": {
					"description": "Whether to display the header.",
					"type": "boolean",
					"default": true
				}
			}
		},
		"footer": {
			"type": "object",
			"properties": {
				"visible": {
					"description": "Whether to display the footer.",
					"type": "boolean",
					"default": true
				}
			}
		}
	}
}
